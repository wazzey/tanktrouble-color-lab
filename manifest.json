{
  "manifest_version": 3,
  "name": "TankTrouble Color Lab",
  "version": "1.0",
  "author": "wazzey",
  "homepage_url": "https://github.com/wazzey/tanktrouble-color-lab",
  "description": "Cosmetic-only fan extension: custom colours, paints, items, map themes and Laika looks. Not affiliated with TankTrouble.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Color Lab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://tanktrouble.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Open or close Color Lab"
    },
    "refresh-tanks": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Alt+V"
      },
      "description": "Refresh your logged-in tanks' colours"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://tanktrouble.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tanktrouble.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "art/*"
      ],
      "matches": [
        "https://tanktrouble.com/*"
      ]
    }
  ]
}
