{
  "name": "tanktrouble-color-lab",
  "private": true,
  "description": "Builds the TankTrouble Color Lab extension zip from the source in this repository.",
  "type": "module",
  "scripts": {
    "check": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "format": "prettier --write src/content.js src/background.js src/bridge.js scripts/build.mjs",
    "format:check": "prettier --check src/content.js src/background.js src/bridge.js scripts/build.mjs"
  },
  "devDependencies": {
    "fflate": "0.8.2",
    "prettier": "3.3.3",
    "terser": "5.31.0"
  },
  "engines": {
    "node": ">=20"
  }
}
