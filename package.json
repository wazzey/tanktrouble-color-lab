{
  "name": "tanktrouble-color-lab",
  "private": true,
  "description": "TankTrouble Color Lab: the extension, its look server and the build.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.js",
    "build:dev": "bun scripts/build.js --dev",
    "dev": "bun scripts/build.js --dev --watch",
    "fmt": "bun fmt --no-script .",
    "fmt:check": "bun fmt --no-script --check .",
    "lint": "bun lint --no-script --deny-warnings",
    "lint:fix": "bun lint --no-script --fix && bun fmt --no-script .",
    "check": "bun fmt --no-script --check . && bun lint --no-script --deny-warnings && bun scripts/build.js"
  },
  "devDependencies": {
    "bun": "1.4.4-canary.20261028.1",
    "fflate": "0.8.3"
  }
}
